{
  "name": "model-sunset",
  "version": "0.1.0",
  "description": "Find hardcoded LLM model IDs in your code and warn when one is retired or about to be. Covers Anthropic, OpenAI and Google, with a shutdown list that updates without a new release.",
  "keywords": [
    "llm",
    "ai",
    "deprecation",
    "model",
    "sunset",
    "retired",
    "claude",
    "anthropic",
    "openai",
    "gpt",
    "gemini",
    "cli",
    "github-action",
    "lint"
  ],
  "homepage": "https://github.com/acus9345/model-sunset#readme",
  "bugs": {
    "url": "https://github.com/acus9345/model-sunset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/model-sunset.git"
  },
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models.json": "./data/models.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "model-sunset": "dist/cli.js"
  },
  "files": [
    "dist",
    "data/models.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
